; Engine configuration file.
; Voltline - Godot 4.3

config_version=5

[application]

config/name="Voltline"
config/description="A pixel-art action platformer / mini-metroidvania about a courier robot in a ruined power plant."
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.02, 0.024, 0.04, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=480
window/size/viewport_height=272
window/size/window_width_override=1440
window/size/window_height_override=816
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.02, 0.024, 0.04, 1)
